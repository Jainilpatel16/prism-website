---
import { company } from '../data/site';
import { url } from '../lib/url';

interface Props {
  title?: string;
  text?: string;
}
const {
  title = 'Let’s collaborate.',
  text = 'Request a quotation, samples, COA or regulatory documents. Our team responds to every inquiry within one business day.',
} = Astro.props;
---

<section class="cta section-tight">
  <div class="container">
    <div class="box">
      <h2>{title}</h2>
      <p class="lead">{text}</p>
      <div class="btn-row">
        <a class="btn btn-primary" href={url('/contact-us/')}>Send an inquiry</a>
        <a class="btn btn-secondary" href={`mailto:${company.email}`}>{company.email}</a>
        <a class="btn btn-ghost" href={`tel:${company.phoneIntl}`}>Call {company.phone}</a>
      </div>
    </div>
  </div>
</section>

<style>
  .box { background: var(--bg-alt); border-radius: 28px; padding: clamp(40px, 7vw, 80px) clamp(24px, 6vw, 80px); text-align: center; }
  .alt .box, :global(.alt) + .cta .box { background: var(--bg-alt); }
  .lead { max-width: 640px; margin: 0 auto 28px; }
  .btn-row { justify-content: center; }
</style>
