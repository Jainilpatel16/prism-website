---
import { url } from '../lib/url';

interface Props {
  eyebrow?: string;
  title: string;
  lead?: string;
  crumbs?: { label: string; href?: string }[];
  alt?: boolean;
}
const { eyebrow, title, lead, crumbs, alt = false } = Astro.props;
---

<section class:list={['page-hero', { alt }]}>
  <div class="container">
    {
      crumbs && (
        <nav class="breadcrumbs" aria-label="Breadcrumb">
          <a href={url('/')}>Home</a>
          {crumbs.map((c) => (
            <>
              <span aria-hidden="true">›</span>
              {c.href ? <a href={url(c.href)}>{c.label}</a> : <span>{c.label}</span>}
            </>
          ))}
        </nav>
      )
    }
    {eyebrow && <span class="eyebrow">{eyebrow}</span>}
    <h1>{title}</h1>
    {lead && <p class="lead">{lead}</p>}
    <slot />
  </div>
</section>
