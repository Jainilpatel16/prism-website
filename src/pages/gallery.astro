---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import { url } from '../lib/url';

const india = ['8790', '8583', '8547', '8543', '8532', '8778', '8611', '8695', '8676'].map((n) => `/wp-content/uploads/2025/07/KVP_${n}-scaled.jpg`);
const australia = ['13.34.40', '13.34.39', '13.34.32-2', '13.34.37', '13.34.43', '13.34.41-1', '13.34.35-2', '13.34.41', '13.34.35-1', '13.34.33-1', '13.34.42'].map(
  (n) => `/wp-content/uploads/2025/07/WhatsApp-Image-2025-07-02-at-${n}.jpeg`,
);
const video = '/wp-content/uploads/2025/07/WhatsApp-Video-2025-07-02-at-13.34.44.mp4';
---

<Base title="Gallery" description="Photos of Prism Industries' API manufacturing plant in Khambhat, Gujarat, India, and our Australian facility.">
  <PageHero eyebrow="Gallery" title="Inside Prism." lead="A look at our manufacturing facilities, laboratories and the people behind our APIs." crumbs={[{ label: 'Company', href: '/company/' }, { label: 'Gallery' }]} />

  <section class="section-tight">
    <div class="container">
      <h2 class="gh">Indian plant</h2>
      <ul class="gallery">
        {india.map((src, i) => <li><a href={url(src)} data-lightbox><img src={url(src)} alt={`Prism Industries plant, Khambhat — photo ${i + 1}`} loading="lazy" /></a></li>)}
      </ul>
    </div>
  </section>

  <section class="section-tight alt">
    <div class="container">
      <h2 class="gh">Australian plant</h2>
      <ul class="gallery">
        {australia.map((src, i) => <li><a href={url(src)} data-lightbox><img src={url(src)} alt={`Australian plant — photo ${i + 1}`} loading="lazy" /></a></li>)}
      </ul>
      <h2 class="gh vh">Australian facility</h2>
      <video class="video" controls preload="metadata" playsinline src={url(video)}></video>
    </div>
  </section>

  <dialog class="lightbox" aria-label="Image viewer">
    <form method="dialog"><button class="close" aria-label="Close">×</button></form>
    <img alt="" />
  </dialog>
</Base>

<style>
  .gh { font-size: clamp(1.5rem, 3vw, 2rem); margin-bottom: 20px; }
  .vh { margin-top: 48px; }
  .gallery { list-style: none; margin: 0; padding: 0; display: grid; gap: 10px; grid-template-columns: repeat(2, 1fr); }
  @media (min-width: 800px) { .gallery { grid-template-columns: repeat(3, 1fr); gap: 14px; } }
  .gallery a { display: block; aspect-ratio: 4 / 3; border-radius: var(--radius-sm); overflow: hidden; background: var(--bg-alt); }
  .gallery img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.4s; }
  .gallery a:hover img { transform: scale(1.04); }
  .video { width: 100%; max-width: 820px; border-radius: var(--radius); background: #000; }
  .lightbox { border: 0; padding: 0; background: transparent; max-width: 94vw; max-height: 92vh; }
  .lightbox::backdrop { background: rgba(255, 255, 255, 0.92); backdrop-filter: blur(10px); }
  .lightbox img { max-width: 94vw; max-height: 88vh; border-radius: var(--radius-sm); box-shadow: var(--shadow-hover); }
  .close { position: fixed; top: 16px; right: 20px; width: 44px; height: 44px; border-radius: 50%; border: 0; background: var(--bg-alt); font-size: 1.6rem; cursor: pointer; color: var(--text); }
</style>

<script>
  const dlg = document.querySelector<HTMLDialogElement>('.lightbox')!;
  const img = dlg.querySelector('img')!;
  document.querySelectorAll<HTMLAnchorElement>('[data-lightbox]').forEach((a) =>
    a.addEventListener('click', (e) => {
      e.preventDefault();
      img.src = a.href;
      img.alt = a.querySelector('img')?.alt ?? '';
      dlg.showModal();
    }),
  );
  dlg.addEventListener('click', (e) => { if (e.target === dlg) dlg.close(); });
</script>
