---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import PostCard from '../components/PostCard.astro';
import { blogCategories } from '../data/site';
import { url } from '../lib/url';

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const topics = [
  { slug: 'quinine', d: 'Cinchona alkaloids, antimalarial formulations and quinine manufacturing.' },
  { slug: 'hyoscine', d: 'Antispasmodic APIs, palliative care and gastrointestinal applications.' },
  { slug: 'artemether', d: 'Artemisinin-based combination therapies for malaria.' },
  { slug: 'lumefantrine', d: 'Lumefantrine API profiles and modern antimalarial therapy.' },
  { slug: 'quinidine', d: 'Quinidine base and sulphate in antiarrhythmic drug development.' },
  { slug: 'nicotine', d: 'Pharmaceutical nicotine, NRT and nicotine salt APIs.' },
  { slug: 'health', d: 'API industry trends, WHO-GMP and regulatory compliance.' },
  { slug: 'medicine', d: 'Active pharmaceutical ingredients and how they influence health.' },
];
const counts = Object.fromEntries(topics.map((t) => [t.slug, posts.filter((p) => p.data.categories.includes(t.slug)).length]));
const guides = ['who-gmp-certification-guide', 'regulatory-compliance-api-supplier-selection', 'the-importance-of-quality-control-in-nicotine-base-usp-ep-manufacturing', 'active-pharmaceutical-ingredients-the-core-of-modern-medicine', 'quinidine-vs-quinine-key-differences-uses-effects', 'quinine-base-manufacturing-from-cinchona-to-finished-api']
  .map((id) => posts.find((p) => p.id === id))
  .filter((p) => p !== undefined);
---

<Base title="Learning Vault" description="Educational resources from Prism Industries on APIs, pharmacopoeial standards, WHO-GMP, regulatory compliance, antimalarials, antispasmodics and pharmaceutical nicotine.">
  <PageHero
    eyebrow="Learning Vault"
    title="Knowledge for pharma professionals."
    lead="Educational resources for formulators, procurement and regulatory teams — on APIs, quality standards and the science behind our products."
    crumbs={[{ label: 'Company', href: '/company/' }, { label: 'Learning Vault' }]}
  />

  <section class="section-tight">
    <div class="container">
      <h2 class="h">Browse by topic</h2>
      <div class="grid grid-4">
        {
          topics.filter((t) => counts[t.slug] > 0).map((t) => (
            <a class="card topic" href={url(`/category/${t.slug}/`)}>
              <h3>{blogCategories[t.slug]}</h3>
              <p class="muted">{t.d}</p>
              <span class="badge">{counts[t.slug]} articles</span>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section-tight alt">
    <div class="container">
      <h2 class="h">Essential guides</h2>
      <div class="grid grid-3">{guides.map((p) => <PostCard post={p!} />)}</div>
      <p class="center more"><a class="btn btn-ghost" href={url('/blog/')}>All {posts.length} articles</a></p>
    </div>
  </section>
</Base>

<style>
  .h { font-size: clamp(1.5rem, 3vw, 2rem); margin-bottom: 24px; }
  .topic h3 { font-size: 1.15rem; }
  .topic p { font-size: 0.92rem; }
  .more { margin-top: 32px; }
  @media (max-width: 699px) { .grid-4 { grid-template-columns: 1fr; } }
</style>
