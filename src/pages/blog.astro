---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import PostCard from '../components/PostCard.astro';
import { blogCategories } from '../data/site';
import { url } from '../lib/url';

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const counts = new Map<string, number>();
posts.forEach((p) => p.data.categories.forEach((c) => counts.set(c, (counts.get(c) ?? 0) + 1)));
const cats = [...counts.keys()].filter((c) => c !== 'uncategorized').sort();
---

<Base title="Blog" description="Insights on API manufacturing, antimalarial and antispasmodic APIs, pharmaceutical nicotine, regulatory compliance and quality from Prism Industries.">
  <PageHero eyebrow="Blog" title="News and insights." lead="Latest articles on API manufacturing, quality and regulatory compliance from the team at Prism Industries." crumbs={[{ label: 'Blog' }]}>
    <nav class="cats" aria-label="Blog categories">
      <a class="chip active" href={url('/blog/')}>All</a>
      {cats.map((c) => <a class="chip" href={url(`/category/${c}/`)}>{blogCategories[c] ?? c}</a>)}
    </nav>
  </PageHero>
  <section class="section-tight alt">
    <div class="container">
      <div class="grid grid-3">
        {posts.map((p) => <PostCard post={p} />)}
      </div>
    </div>
  </section>
</Base>

<style>
  .cats { margin-top: 28px; display: flex; flex-wrap: wrap; justify-content: center; gap: 8px; }
  .chip { font-size: 0.9rem; font-weight: 500; padding: 9px 16px; border-radius: 980px; border: 1px solid var(--line); color: var(--text-2); text-decoration: none; }
  .chip:hover { border-color: var(--text-2); text-decoration: none; }
  .chip.active { background: var(--text); color: #fff; border-color: var(--text); }
</style>
