---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import ProductCard from '../../components/ProductCard.astro';
import ContactCTA from '../../components/ContactCTA.astro';
import { productCategories, company } from '../../data/site';
import { url } from '../../lib/url';

export async function getStaticPaths() {
  const products = await getCollection('products');
  return products.map((p) => ({ params: { slug: p.id }, props: { product: p, all: products } }));
}

interface Props {
  product: CollectionEntry<'products'>;
  all: CollectionEntry<'products'>[];
}
const { product, all } = Astro.props;
const d = product.data;
const { Content } = await render(product);
const cat = productCategories[d.category];
const related = all.filter((p) => p.data.category === d.category && p.id !== product.id).slice(0, 3);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: d.title,
  description: d.description,
  category: cat.name,
  brand: { '@type': 'Brand', name: company.name },
  manufacturer: { '@type': 'Organization', name: company.name },
  ...(d.image ? { image: new URL(url(d.image), Astro.site).href } : {}),
  ...(d.cas ? { additionalProperty: [{ '@type': 'PropertyValue', name: 'CAS Number', value: d.cas }] } : {}),
};
---

<Base title={`${d.title} Manufacturer & Supplier`} description={d.description} image={d.image} jsonLd={jsonLd}>
  <section class="product-hero">
    <div class="container">
      <nav class="breadcrumbs" aria-label="Breadcrumb">
        <a href={url('/')}>Home</a><span aria-hidden="true">›</span>
        <a href={url('/products/')}>Products</a><span aria-hidden="true">›</span>
        <span>{d.title}</span>
      </nav>
      <div class="head">
        <div>
          <div class="tags">
            <span class="badge">{cat.name}</span>
            {d.grade && <span class="badge badge-blue">{d.grade} grade</span>}
            <span class="badge">WHO-GMP manufactured</span>
          </div>
          <h1>{d.title}</h1>
          <p class="lead">Pharmaceutical-grade API manufactured by {company.name} in Khambhat, Gujarat, India.</p>
          <div class="btn-row">
            <a class="btn btn-primary" href={url(`/contact-us/?product=${product.id}`)}>Request a quote</a>
            {d.coa && <a class="btn btn-secondary" href={url(d.coa)} target="_blank" rel="noopener">Download COA</a>}
            {d.msds && <a class="btn btn-ghost" href={url(d.msds)} target="_blank" rel="noopener">Download MSDS</a>}
          </div>
        </div>
        <aside class="facts" aria-label="Key facts">
          <dl>
            <div><dt>Product</dt><dd>{d.title}</dd></div>
            {d.grade && <div><dt>Grade</dt><dd>{d.grade}</dd></div>}
            {d.cas && <div><dt>CAS No.</dt><dd>{d.cas}</dd></div>}
            {d.formula && <div><dt>Molecular formula</dt><dd>{d.formula}</dd></div>}
            <div><dt>Category</dt><dd>{cat.short}</dd></div>
            <div><dt>Documents</dt><dd>COA, MSDS, GMP certificate, stability data on request</dd></div>
            <div><dt>Origin</dt><dd>Khambhat, Gujarat, India</dd></div>
          </dl>
        </aside>
      </div>
    </div>
  </section>

  <section class="section-tight">
    <div class="container container-narrow">
      <article class="prose">
        <Content />
      </article>
    </div>
  </section>

  {
    related.length > 0 && (
      <section class="section-tight alt">
        <div class="container">
          <h2 class="rel-title">Related products</h2>
          <div class="grid grid-3">
            {related.map((p) => <ProductCard product={p} />)}
          </div>
        </div>
      </section>
    )
  }

  <ContactCTA title={`Source ${d.title} from Prism.`} text="Bulk commercial quantities, R&D samples and full regulatory documentation. Tell us your grade, volume and destination market." />
</Base>

<style>
  .product-hero { padding: clamp(40px, 6vw, 72px) 0 clamp(32px, 5vw, 56px); background: var(--bg-alt); }
  .head { display: grid; gap: 32px; align-items: start; }
  @media (min-width: 900px) { .head { grid-template-columns: 1.4fr 1fr; gap: 56px; } }
  .tags { display: flex; flex-wrap: wrap; gap: 6px; margin-bottom: 18px; }
  .tags .badge { background: var(--bg); }
  .tags .badge-blue { background: rgba(0, 113, 227, 0.1); }
  h1 { font-size: clamp(2.2rem, 5.5vw, 3.6rem); }
  .lead { margin-bottom: 26px; }
  .facts { background: var(--bg); border-radius: var(--radius); padding: 8px 24px; box-shadow: var(--shadow); }
  .facts dl { margin: 0; }
  .facts div { display: grid; grid-template-columns: 130px 1fr; gap: 12px; padding: 14px 0; border-bottom: 1px solid var(--line-soft); font-size: 0.92rem; }
  .facts div:last-child { border-bottom: 0; }
  .facts dt { color: var(--muted); }
  .facts dd { margin: 0; color: var(--text); font-weight: 500; word-break: break-word; }
  .rel-title { font-size: clamp(1.5rem, 3vw, 2rem); margin-bottom: 24px; }
</style>
